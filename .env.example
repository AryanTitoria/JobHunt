DEBUG=true
SECRET_KEY=development-only-JobSearch-change-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# PostgreSQL for production. SQLite works for a single-machine mentor demo.
# DATABASE_URL=postgresql://user:password@database:5432/JobSearch
# DATA_DIR=/app/data

# Online models only. First configured provider is primary.
# Fallback is allowed only when the user consents in Profile.
AI_PROVIDERS=gemini,groq,openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_USER_LIMIT=8
AI_DAILY_GLOBAL_LIMIT=100
AI_DAILY_TOKEN_BUDGET=200000

BRAVE_SEARCH_API_KEY=
DISCOVERY_MAX_QUERIES=4
DISCOVERY_MAX_PAGES=8
DISCOVERY_MAX_BOARDS=30
# Demo mode loads labelled fictional jobs. It is not an offline AI model.
DEMO_MODE=false
# Set only behind your own trusted HTTPS reverse proxy:
TRUST_PROXY_HTTPS=false
SECURE_SSL_REDIRECT=true

# Web discovery: add either or both. Calls rotate across configured providers.
SEARCH_PROVIDERS=tavily,brave
TAVILY_API_KEY=
TAVILY_MONTHLY_LIMIT=800
BRAVE_MONTHLY_LIMIT=800

# Optional registered job APIs. Also enable them in discovery.json.
# Adzuna provides both values; free evaluation/account terms apply.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# USAJOBS federal vacancies: the registered email is required as User-Agent.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Maximum attempts per registered job-API provider per UTC day.
JOB_API_DAILY_LIMIT=40
